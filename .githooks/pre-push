#!/usr/bin/env sh

# Run lldtdd's own lint against itself before every push -- dogfooding: a stale
# **method:** annotation or a silently-dropped claim bullet should be caught here, not
# discovered months later in a review sweep.
#
# The default glob is enough now: it skips node_modules and any fixtures/ directory, so the
# documents under lld/fixtures/ that are broken or failing on purpose stay out of this sweep
# without a hand-tuned pattern. That exclusion used to be duplicated here and in CI, which is
# what showed it belonged in the tool instead.
#
# `lint` reads the modules its documents point at; it does not import or run them. That matters
# here specifically: this hook fires on an ordinary `git push`, including of someone else's
# branch checked out to review, and nobody expects pushing to execute code. Do not add
# `--execute` to this line.

# The files the pushed commits change: against what the remote has, or, for a new branch or a
# remote commit not here, everything not on the remote yet. A deleted ref pushes nothing.
zero=0000000000000000000000000000000000000000
pushed=$(while read -r _localRef localSha _remoteRef remoteSha; do
	[ "$localSha" = "$zero" ] && continue
	if [ "$remoteSha" != "$zero" ] && git cat-file -e "$remoteSha^{commit}" 2>/dev/null; then
		git log --format= --name-only "$remoteSha..$localSha"
	else
		git log --format= --name-only "$localSha" --not --remotes="$1"
	fi
done)

if echo "$pushed" | grep -q '\.lld\.md$'; then
	bun run src/cli.ts lint || exit 1
fi
