#!/usr/bin/env sh

# Run lldtdd's own lint against itself before every commit -- dogfooding: a stale
# **method:** annotation or a silently-dropped claim bullet should be caught here, not
# discovered months later in a review sweep.
#
# The default glob is enough now: it skips node_modules and any fixtures/ directory, so the
# documents under lld/fixtures/ that are broken or failing on purpose stay out of this sweep
# without a hand-tuned pattern. That exclusion used to be duplicated here and in CI, which is
# what showed it belonged in the tool instead.
#
# `lint` reads the modules its documents point at; it does not import or run them. That matters
# here specifically: this hook fires on an ordinary `git commit`, including right after checking
# out someone else's branch, and nobody expects committing to execute code. Do not add
# `--execute` to this line.
changedLLDs=$(git diff --name-only --cached | grep -c "\.lld\.md$")
if [ "$changedLLDs" -gt 0 ]; then
	bun run src/cli.ts lint || exit 1
fi
