,
  "method": undefined,
}
`;

exports[`deriveEventTargetInline matches: does the subscription continue receiving updates after a parser error 1`] = `
{
  "callArgs": [],
  "inspectCode": 
"const _ctx = new _SubjectCtor({});
let _received;
let _first = true;
_ctx.subscribe({ key: "x", callback: v => { _received = v; }, parser: v => { if (_first) { _first = false; throw new Error("bad"); } return v; } });
_ctx["x"] = "a";
_ctx["x"] = "b";
expect(_received).toBe("b");"
,
  "method": undefined,
}
`;

