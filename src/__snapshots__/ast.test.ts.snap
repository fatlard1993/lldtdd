let _count = 0;
_ctx.addEventListener("x", () => { _count++; }, { signal: _controller.signal });
_ctx["x"] = "a";
_controller.abort();
_ctx["x"] = "b";
expect(_count).toBe(1);"
,
  "method": undefined,
}
`;

exports[`deriveEventTargetInline matches: does the subscriber receive the parser's output rather than the raw value 1`] = `
{
  "callArgs": [],
  "inspectCode": 
